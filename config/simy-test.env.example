# simy-env: simy-test
# Einmalig kopieren nach ~/.config/simy/simy-test.env und nur dort ausfüllen.
# Die Datei liegt außerhalb jedes Git-Worktrees. Nicht ins Repository kopieren.
# Nur simy-test. Keine Production-Werte (Supabase, Stripe, Wallee, Resend, Twilio, Vercel).
# Jeder andere Variablenname wird abgelehnt.
#
# Danach, in jedem Worktree mit diesem Stand:
#   npm run dev
#   npm run test:e2e
#   scripts/load-simy-test-env.sh --profile all -- <befehl>
SIMY_ENV_TARGET=simy-test
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=
E2E_BASE_URL=http://127.0.0.1:3000
E2E_DEMO_PASSWORD=
E2E_ISOLATION_PASSWORD=
E2E_STAFF_EMAIL=
E2E_WORKING_HOUR_EXCEPTIONS=
