{
  "redirects": [
    {
      "source": "/((?!_nuxt/|_payload|api/|fahrschule|marketing|branchen|vergleich|coaching|consulting|personal-training|nachhilfe|musikschule|hundeschule|massage|preise|demo|kunden|kontakt|impressum|agb|datenschutz|konto-loeschen|features|ueber-uns|partner|sitemap|robots\\.txt|screenshots/|devices/|.*\\.(?:png|jpe?g|webp|gif|svg|ico|woff2?|ttf|css|js|map|xml|txt|pdf|json|webmanifest)$).+)",
      "destination": "https://app.simy.ch/$1",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/_nuxt/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/((?!_nuxt).*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    }
  ]
}
