# fastlane/Fastfile
# Fastlane configuration for white-label iOS builds.
# Reads CLIENT env var to load the correct client config.

# Load root .env for local development (ignored in CI where secrets are injected)
root_env = File.join(File.dirname(__FILE__), '..', '.env')
if File.exist?(root_env)
  File.readlines(root_env).each do |line|
    line = line.strip
    next if line.empty? || line.start_with?('#')
    key, val = line.split('=', 2)
    ENV[key] = val if key && val && ENV[key].nil?
  end
end

default_platform(:ios)

# ─── Helper: Load client config ──────────────────────────────────────────────

def load_client_config
  client_id = ENV['CLIENT'] || 'driving-team'
  config_path = File.join(File.dirname(__FILE__), '..', 'clients', client_id, 'config.json')

  unless File.exist?(config_path)
    UI.user_error!("Client config not found: #{config_path}")
  end

  require 'json'
  JSON.parse(File.read(config_path))
end

def connect_api_key
  p8 = File.expand_path("~/.appstoreconnect/private_keys/AuthKey_#{ENV['APPLE_API_KEY_ID']}.p8")
  UI.user_error!("App Store Connect .p8 missing: #{p8}") unless File.exist?(p8)
  app_store_connect_api_key(
    key_id:        ENV['APPLE_API_KEY_ID'],
    issuer_id:     ENV['APPLE_API_ISSUER_ID'],
    key_filepath:  p8,
    in_house:      false,
  )
end

# ─── iOS Platform ─────────────────────────────────────────────────────────────

platform :ios do

  # ---------------------------------------------------------------------------
  # sync_certificates: Downloads or creates provisioning profiles via Match
  # ---------------------------------------------------------------------------
  lane :sync_certificates do
    client = load_client_config
    setup_ci if is_ci

    git_url = ENV['MATCH_GIT_URL'].to_s.strip
    git_url = 'https://github.com/Kilchi555/simy-certificates.git' if git_url.empty?
    UI.user_error!('MATCH_PASSWORD is missing (GitHub secret / .env). Needed to decrypt Match certs.') if ENV['MATCH_PASSWORD'].to_s.strip.empty?
    UI.user_error!('MATCH_GIT_TOKEN is missing. CI needs a PAT with access to the Match repo.') if ENV['MATCH_GIT_TOKEN'].to_s.strip.empty?

    match(
      type:                'appstore',
      app_identifier:      client['bundleId'],
      git_url:             git_url,
      git_branch:          'main',
      git_basic_authorization: Base64.strict_encode64("x-access-token:#{ENV['MATCH_GIT_TOKEN']}"),
      readonly:            is_ci,
      team_id:             ENV['APPLE_TEAM_ID'],
      skip_confirmation:    true,
      api_key:             connect_api_key,
    )
  end

  # ---------------------------------------------------------------------------
  # create_app: Creates a new app in App Store Connect (run once per client)
  # ---------------------------------------------------------------------------
  lane :create_app do
    client = load_client_config

    produce(
      api_key:        connect_api_key,
      app_identifier: client['bundleId'],
      app_name:       client['appName'],
      language:       'German',
      app_version:    client['version'],
      sku:            client['clientId'],
      team_id:        ENV['APPLE_TEAM_ID'],
    )
  end

  # deploy: Match signing (CI has no Apple ID) → TestFlight or App Store
  lane :deploy do
    setup_ci if is_ci

    client     = load_client_config
    target     = ENV['DEPLOY_TARGET'] || 'testflight'
    version    = client['version']
    bundle_id  = client['bundleId']
    app_name   = client['appName']

    UI.message("🚀 Deploying #{app_name} (#{bundle_id}) v#{version} → #{target}")

    api_key = connect_api_key

    sh("cd .. && CLIENT=#{client['clientId']} node scripts/gen-cap-config.mjs")
    sh('cd .. && npx cap sync ios')

    increment_version_number(
      version_number: version,
      xcodeproj: 'ios/App/App.xcodeproj'
    )
    increment_build_number(
      build_number: Time.now.strftime('%Y%m%d%H%M'),
      xcodeproj: 'ios/App/App.xcodeproj'
    )

    set_info_plist_value(
      path: 'ios/App/App/Info.plist',
      key: 'CFBundleDisplayName',
      value: app_name
    )

    sh('cd .. && fastlane/strip-ats.sh')

    sync_certificates
    profile_name = ENV["sigh_#{bundle_id}_appstore_profile-name"]
    profile_path = ENV["sigh_#{bundle_id}_appstore_profile-path"]
    UI.user_error!("Match installed no App Store profile for #{bundle_id}. Run locally: CLIENT=#{client['clientId']} bundle exec fastlane ios sync_certificates") if profile_name.to_s.empty?

    team_id = ENV['APPLE_TEAM_ID'].to_s.strip
    team_id = client.dig('ios', 'teamId').to_s.strip if team_id.empty?
    UI.user_error!('APPLE_TEAM_ID missing') if team_id.empty?

    # Xcode 16+ ignores ~/Library/MobileDevice/Provisioning Profiles
    require 'fileutils'
    profile_dirs = [
      File.expand_path('~/Library/MobileDevice/Provisioning Profiles'),
      File.expand_path('~/Library/Developer/Xcode/UserData/Provisioning Profiles'),
    ]
    profile_dirs.each { |dir| FileUtils.mkdir_p(dir) }
    if profile_path.to_s != '' && File.exist?(profile_path)
      install_provisioning_profile(path: profile_path)
      src = File.expand_path(profile_path)
      profile_dirs.each do |dir|
        dest = File.expand_path(File.join(dir, File.basename(src)))
        next if src == dest
        FileUtils.cp(src, dest)
      end
    end

    update_code_signing_settings(
      use_automatic_signing: false,
      path: 'ios/App/App.xcodeproj',
      team_id: team_id,
      targets: ['App'],
      bundle_identifier: bundle_id,
      code_sign_identity: 'Apple Distribution',
      profile_name: profile_name,
      build_configurations: ['Release', 'Debug'],
    )

    build_app(
      project:              'ios/App/App.xcodeproj',
      scheme:               'App',
      configuration:        'Release',
      export_method:        'app-store',
      output_directory:     './build',
      output_name:          "#{client['clientId']}.ipa",
      clean:                true,
      skip_profile_detection: true,
      xcargs:               "CODE_SIGN_STYLE=Manual DEVELOPMENT_TEAM=#{team_id} PROVISIONING_PROFILE_SPECIFIER='#{profile_name}'",
      export_options: {
        signingStyle: 'manual',
        teamID:       team_id,
        provisioningProfiles: {
          bundle_id => profile_name,
        },
        uploadBitcode:  false,
        uploadSymbols:  true,
        compileBitcode: false,
      }
    )

    if target == 'appstore'
      # 4a. Upload to App Store (requires metadata)
      deliver(
        api_key:                    api_key,
        app_identifier:             bundle_id,
        ipa:                        "./build/#{client['clientId']}.ipa",
        submit_for_review:          false,
        automatic_release:          false,
        force:                      true,
        skip_screenshots:           true,
        skip_metadata:              true,
        run_precheck_before_submit: false,
      )
      UI.success("✅ #{app_name} uploaded to App Store (pending review)")
    else
      # 4b. Upload to TestFlight
      upload_to_testflight(
        api_key:      api_key,
        ipa:          "./build/#{client['clientId']}.ipa",
        skip_waiting_for_build_processing: true,
      )
      UI.success("✅ #{app_name} uploaded to TestFlight")
    end
  end

  # ---------------------------------------------------------------------------
  # upload_metadata: Upload only metadata (description, keywords, release notes)
  # without rebuilding or re-uploading the binary. Skips app name (already set).
  # Usage: CLIENT=simy bundle exec fastlane upload_metadata
  # ---------------------------------------------------------------------------
  lane :upload_metadata do
    client  = load_client_config
    bundle_id = client['bundleId']

    api_key = app_store_connect_api_key(
      key_id:        ENV['APPLE_API_KEY_ID'],
      issuer_id:     ENV['APPLE_API_ISSUER_ID'],
      key_filepath:  File.expand_path("~/.appstoreconnect/private_keys/AuthKey_#{ENV['APPLE_API_KEY_ID']}.p8"),
      in_house:      false,
    )

    # Temporarily hide name.txt files so deliver doesn't try to update the app name
    # (Apple rejects name changes if it's already registered by another app)
    name_files = Dir.glob("../clients/#{client['clientId']}/metadata/**/name.txt")
    name_files.each { |f| File.rename(f, "#{f}.bak") }

    begin
      deliver(
        api_key:                    api_key,
        app_identifier:             bundle_id,
        skip_binary_upload:         true,
        skip_screenshots:           true,
        skip_metadata:              false,
        submit_for_review:          false,
        automatic_release:          false,
        force:                      true,
        run_precheck_before_submit: false,
        metadata_path:              "./clients/#{client['clientId']}/metadata",
      )
      UI.success("✅ Metadata uploaded for #{client['appName']}")
    ensure
      name_files.each { |f| File.rename("#{f}.bak", f) if File.exist?("#{f}.bak") }
    end
  end

  # ---------------------------------------------------------------------------
  # After all: Restore Info.plist (Dev ATS exceptions) — always runs after a lane
  # ---------------------------------------------------------------------------
  after_all do |lane, options|
    # Restore the Dev-only Info.plist (with NSAllowsArbitraryLoads) so local Live-Reload
    # keeps working after a release build.
    if File.exist?('../ios/App/App/Info.plist.bak')
      sh('cd .. && fastlane/restore-ats.sh')
    end
  end

  # ---------------------------------------------------------------------------
  # Error handler — also restore Info.plist on failure
  # ---------------------------------------------------------------------------
  error do |lane, exception, options|
    UI.error("❌ Lane '#{lane}' failed: #{exception.message}")
    if File.exist?('../ios/App/App/Info.plist.bak')
      sh('cd .. && fastlane/restore-ats.sh')
    end
  end

end
